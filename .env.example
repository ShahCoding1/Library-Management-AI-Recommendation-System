# Master System Environment Configuration

# Django Core
SECRET_KEY=change-in-production-django-insecure-master-fyp-key-123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite for local development, switch to PostgreSQL for production)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# For PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=library_system
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Recommendation Model Configuration
CONTENT_WEIGHT=0.25
COLLABORATIVE_WEIGHT=0.20
MOOD_WEIGHT=0.20
PREFERENCE_WEIGHT=0.15
POPULARITY_WEIGHT=0.08
RATING_WEIGHT=0.07
RECENCY_WEIGHT=0.03
AVAILABILITY_WEIGHT=0.02
TOP_K=10
MIN_COLLABORATIVE_INTERACTIONS=3
SESSION_INACTIVITY_TIMEOUT_SECONDS=1800
